<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F6F8FB"
    android:layoutDirection="rtl">

    <!-- Header -->

<LinearLayout
android:layout_width="match_parent"
android:layout_height="64dp"

android:orientation="horizontal"
android:gravity="center_vertical"

android:paddingStart="12dp"
android:paddingEnd="18dp"

android:background="#FFFFFF"
android:elevation="2dp">

<ImageButton
    android:id="@+id/buttonBack"

    android:layout_width="44dp"
    android:layout_height="44dp"

    android:background="?attr/selectableItemBackgroundBorderless"

    android:src="@android:drawable/ic_menu_revert"

    android:contentDescription="חזרה"/>

<TextView
    android:layout_width="0dp"
    android:layout_height="wrap_content"

    android:layout_weight="1"

    android:gravity="center"

    android:text="פרטי בית הכנסת"

    android:textColor="#182230"
    android:textSize="20sp"
    android:textStyle="bold"/>

<View
    android:layout_width="44dp"
    android:layout_height="44dp"/>

</LinearLayout>

<ScrollView
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1"

android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"

    android:paddingBottom="28dp">

    <!-- Map -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="230dp"

        android:layout_marginBottom="18dp"

        app:cardCornerRadius="0dp"
        app:cardElevation="0dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/detailMap"

            android:name="com.google.android.gms.maps.SupportMapFragment"

            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- Main information -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="בית כנסת"

            android:textColor="#1967D2"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textDetailName"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="בית כנסת"

            android:textColor="#182230"
            android:textSize="28sp"
            android:textStyle="bold"

            android:maxLines="3"/>

        <!-- Address card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"

            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="#E4EAF1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"

                android:gravity="center_vertical"

                android:padding="16dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"

                    android:gravity="center"

                    android:text="📍"
                    android:textSize="21sp"

                    android:background="#EAF3FF"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:orientation="vertical"

                    android:paddingStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="כתובת"

                        android:textColor="#718096"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/textDetailAddress"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="כתובת"

                        android:textColor="#263445"
                        android:textSize="16sp"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Description -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="12dp"

            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="#E4EAF1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="אודות בית הכנסת"

                    android:textColor="#182230"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textDetailDescription"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:textColor="#566575"
                    android:textSize="15sp"

                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Contact -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="22dp"

            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"

            app:strokeColor="#E4EAF1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="יצירת קשר"

                    android:textColor="#182230"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textDetailPhone"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:textColor="#566575"
                    android:textSize="15sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCall"

                        android:layout_width="0dp"
                        android:layout_height="52dp"

                        android:layout_weight="1"

                        android:text="התקשר"

                        android:textSize="15sp"
                        android:textStyle="bold"

                        app:cornerRadius="16dp"
                        app:icon="@android:drawable/ic_menu_call"
                        app:iconGravity="textStart"/>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonNavigate"

                        android:layout_width="0dp"
                        android:layout_height="52dp"

                        android:layout_weight="1"

                        android:text="נווט"

                        android:textSize="15sp"
                        android:textStyle="bold"

                        app:cornerRadius="16dp"
                        app:icon="@android:drawable/ic_menu_mylocation"
                        app:iconGravity="textStart"
                        app:backgroundTint="#EAF3FF"
                        app:iconTint="#1967D2"
                        android:textColor="#1967D2"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Prayers -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="זמני תפילות"

            android:textColor="#182230"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="3dp"
            android:layout_marginBottom="12dp"

            android:text="כל זמני התפילות לפי ימי השבוע"

            android:textColor="#718096"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/prayersContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:layout_marginBottom="24dp"/>

        <!-- Features -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="מה יש בבית הכנסת?"

            android:textColor="#182230"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="3dp"
            android:layout_marginBottom="12dp"

            android:text="שירותים ומאפיינים"

            android:textColor="#718096"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/featuresContainer"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"/>

    </LinearLayout>

</LinearLayout>

</ScrollView>

    </LinearLayout>
