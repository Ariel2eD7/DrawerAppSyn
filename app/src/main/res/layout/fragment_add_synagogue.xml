<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הוספת בית כנסת"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שם בית הכנסת (חובה)"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/editSynagogueName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="לדוגמה: בית הכנסת הגדול"
            android:inputType="text"
            android:textDirection="firstStrong"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="כתובת (חובה)"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/editAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="רחוב, מספר, עיר"
            android:inputType="textPostalAddress"
            android:textDirection="firstStrong"
            android:layout_marginBottom="10dp"/>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/addSynagogueMap"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="טלפון (אופציונלי)"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/editPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="050-1234567"
            android:inputType="phone"
            android:textDirection="ltr"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שם משתמש (חובה)"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/editUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="שם משתמש להתחברות"
            android:inputType="text"
            android:textDirection="firstStrong"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="סיסמה (חובה)"
            android:textSize="16sp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/editPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="סיסמה"
            android:inputType="textPassword"
            android:textDirection="ltr"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שעות פתיחה (אופציונלי)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/buttonAddHeader"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="+ כותרת"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:backgroundTint="#E3F2FD"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/buttonAddOpeningHour"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="+ שעת תפילה"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/openingHoursContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/buttonRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הרשמה"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>
