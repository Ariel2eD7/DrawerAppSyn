<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layoutDirection="rtl">

        <!-- ================================== -->
        <!-- כותרת -->
        <!-- ================================== -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הפרופיל שלי"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ניהול פרטי בית הכנסת"
            android:textSize="14sp"
            android:textColor="#68737D"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- ================================== -->
        <!-- כרטיס ראשי -->
        <!-- ================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- שם -->

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="בית הכנסת"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- סטטוס -->

                <TextView
                    android:id="@+id/profileStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="פעיל"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:background="#E8F5E9"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp" />

                <!-- קו -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E9EE"
                    android:layout_marginBottom="18dp" />

                <!-- ================================== -->
                <!-- כתובת -->
                <!-- ================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="כתובת"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#68737D"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/profileAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="לא הוגדרה כתובת."
                    android:textSize="16sp"
                    android:textColor="#20252B"
                    android:layout_marginBottom="16dp" />

                <!-- ================================== -->
                <!-- טלפון -->
                <!-- ================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="טלפון"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#68737D"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/profilePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="לא הוגדר טלפון."
                    android:textSize="16sp"
                    android:textColor="#20252B"
                    android:layout_marginBottom="16dp" />

                <!-- ================================== -->
                <!-- תיאור -->
                <!-- ================================== -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="אודות בית הכנסת"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#68737D"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/profileDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="לא נוסף תיאור."
                    android:textSize="16sp"
                    android:textColor="#20252B"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================== -->
        <!-- שעות תפילה -->
        <!-- ================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="שעות תפילה"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/profilePrayers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="טוען..."
                    android:textSize="15sp"
                    android:textColor="#20252B"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================== -->
        <!-- מאפיינים -->
        <!-- ================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="מאפייני בית הכנסת"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/profileFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="טוען..."
                    android:textSize="15sp"
                    android:textColor="#20252B"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================== -->
        <!-- טעינה -->
        <!-- ================================== -->

        <ProgressBar
            android:id="@+id/profileProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />


        <!-- ================================== -->
        <!-- עריכת פרופיל -->
        <!-- ================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editProfileButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="עריכת פרטי בית הכנסת"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/primary"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>
