<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F6F8FB"
    android:layoutDirection="rtl">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"

        android:background="@android:color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="בתי כנסת"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#182230"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="מצא בית כנסת קרוב אליך"
            android:textSize="15sp"
            android:textColor="#6F7B87"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"

            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/searchInput"

                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"

                android:background="@drawable/bg_search_field"

                android:hint="חיפוש לפי שם או כתובת"
                android:textSize="15sp"
                android:textColor="#182230"
                android:textColorHint="#8995A3"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonLogin"

                android:layout_width="wrap_content"
                android:layout_height="52dp"

                android:layout_marginStart="8dp"

                android:text="התחברות"
                android:textSize="14sp"
                android:textStyle="bold"

                android:textColor="#1967D2"

                app:backgroundTint="#EAF2FF"
                app:cornerRadius="16dp"

                app:strokeWidth="0dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Map -->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="190dp"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="14dp"

        app:cardCornerRadius="22dp"
        app:cardElevation="2dp">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"

            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </androidx.cardview.widget.CardView>

    <!-- Results header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"

        android:gravity="center_vertical">

        <TextView
            android:id="@+id/resultCount"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="בתי כנסת"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263442"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAddSynagogue"

            android:layout_width="wrap_content"
            android:layout_height="42dp"

            android:text="+ הוספת בית כנסת"
            android:textSize="13sp"
            android:textStyle="bold"

            android:textColor="@android:color/white"

            app:backgroundTint="#1967D2"
            app:cornerRadius="14dp"

            app:strokeWidth="0dp"/>

    </LinearLayout>

    <!-- Loading -->

    <TextView
        android:id="@+id/loadingText"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:paddingTop="12dp"
        android:paddingBottom="12dp"

        android:text="טוען בתי כנסת..."
        android:textSize="15sp"
        android:textColor="#6F7B87"/>

    <!-- Empty state -->

    <TextView
        android:id="@+id/emptyState"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"

        android:text="לא נמצאו בתי כנסת"
        android:textSize="16sp"
        android:textColor="#6F7B87"

        android:visibility="gone"/>

    <!-- List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewUsers"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp"

        android:clipToPadding="false"/>

</LinearLayout>
