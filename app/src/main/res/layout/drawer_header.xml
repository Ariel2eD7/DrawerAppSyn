<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:background="@color/primary">

    <!-- ================================== -->
    <!-- תוכן מרכזי של ה-Header -->
    <!-- ================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp">

        <!-- ================================== -->
        <!-- מצב אורח -->
        <!-- ================================== -->

        <LinearLayout
            android:id="@+id/drawerGuestSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layoutDirection="rtl">

            <!-- הרשמה -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/drawerAddSynagogueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="להוספת בית כנסת"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawerRegisterButton"
                    android:layout_width="100dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="5dp"
                    android:text="הרשמה"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:cornerRadius="19dp"
                    app:backgroundTint="@android:color/white" />

            </LinearLayout>

            <!-- קו הפרדה -->

            <View
                android:layout_width="1dp"
                android:layout_height="65dp"
                android:background="#40FFFFFF" />

            <!-- כניסה -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="כבר יש לכם חשבון?"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawerLoginButton"
                    android:layout_width="100dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="5dp"
                    android:text="כניסה"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:cornerRadius="19dp"
                    app:backgroundTint="@color/primary"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================== -->
        <!-- מצב משתמש מחובר -->
        <!-- ================================== -->

        <LinearLayout
            android:id="@+id/drawerLoggedInSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:visibility="gone">

            <!-- פרופיל -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/drawerWelcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="שלום!"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawerProfileButton"
                    android:layout_width="110dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="5dp"
                    android:text="הפרופיל שלי"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:cornerRadius="19dp"
                    app:backgroundTint="@android:color/white" />

            </LinearLayout>

            <!-- קו הפרדה -->

            <View
                android:layout_width="1dp"
                android:layout_height="65dp"
                android:background="#40FFFFFF" />

            <!-- התנתקות -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/drawerLoggedInEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="מחובר"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawerLogoutButton"
                    android:layout_width="100dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="5dp"
                    android:text="התנתקות"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:cornerRadius="19dp"
                    app:backgroundTint="@color/primary"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================== -->
        <!-- אזור המיתוג -->
        <!-- ================================== -->

        <ImageView
            android:id="@+id/drawerLogo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="לוגו האפליקציה" />

        <TextView
            android:id="@+id/drawerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="בתי הכנסת"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/drawerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="מצאו בית כנסת קרוב אליכם"
            android:textSize="14sp"
            android:textColor="#E8E8E8" />

    </LinearLayout>


    <!-- ================================== -->
    <!-- תאריך עברי -->
    <!-- ================================== -->

    <TextView
        android:id="@+id/hebrewDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="3dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#E8E8E8"
        android:text="טוען תאריך..." />

</FrameLayout>
