xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@color/primary">

    <!-- כפתורי משתמש והרשמה -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <!-- התחברות -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerLoginButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="התחברות"
            android:text=""
            android:padding="0dp"
            app:icon="@drawable/ic_person"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="23dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@android:color/white"
            app:iconTint="@color/primary" />

        <!-- הרשמת בית כנסת -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerRegisterButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="הרשמת בית כנסת"
            android:text=""
            android:padding="0dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="23dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@android:color/white"
            app:iconTint="@color/primary" />

    </LinearLayout>

    <ImageView
        android:id="@+id/drawerLogo"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="לוגו האפליקציה" />

    <TextView
        android:id="@+id/drawerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="בתי הכנסת"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/drawerSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="מצאו בית כנסת קרוב אליכם"
        android:textSize="14sp"
        android:textColor="#777777" />

    <TextView
        android:id="@+id/hebrewDateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#333333" />

</LinearLayout>

