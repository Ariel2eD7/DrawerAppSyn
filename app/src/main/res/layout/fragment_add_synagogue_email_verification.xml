<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <!-- Header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הרשמת בית כנסת"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:gravity="center"
            android:layout_marginBottom="18dp"/>

        <!-- Progress -->


        <include
            android:id="@+id/registrationProgressInclude"
            layout="@layout/registration_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />



        <!-- Email icon -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✉"
            android:textSize="64sp"
            android:textColor="#3F51B5"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Title -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="אמתו את כתובת האימייל"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="שלחנו אליכם קישור לאימות החשבון."
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <!-- Email -->

        <TextView
            android:id="@+id/emailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="example@email.com"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"/>

        <!-- Instructions -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#F5F7FF"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. פתחו את תיבת הדואר שלכם"
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. פתחו את הודעת האימות שקיבלתם"
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. לחצו על קישור האימות"
                android:textSize="15sp"
                android:textColor="#333333"/>

        </LinearLayout>

        <!-- Check -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✓ בדקתי את האימייל"
            android:textSize="16sp"/>

        <!-- Resend -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resendButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="שלח שוב"
            android:textSize="15sp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_marginTop="4dp"/>

        <!-- Back -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="חזרה"
            android:textSize="15sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</ScrollView>